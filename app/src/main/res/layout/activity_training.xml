<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_green"
    android:padding="24dp">

    <!-- Название положения -->
    <TextView
        android:id="@+id/tvPositionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сидя"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Рисунок -->
    <ImageView
        android:id="@+id/ivPositionImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/sitting"
        android:contentDescription="Положение тела"
        app:layout_constraintTop_toBottomOf="@id/tvPositionName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:elevation="8dp"/>

    <!-- Сопротивление -->
    <TextView
        android:id="@+id/tvResistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сопротивление: 5"
        android:textSize="18sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/ivPositionImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Кнопка Пауза/Продолжить (между сопротивлением и таймером) -->
    <ImageButton
        android:id="@+id/btnPause"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_pause"
        android:background="@drawable/btn_circle_white"
        android:contentDescription="Пауза"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/tvResistance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:elevation="4dp"
        android:stateListAnimator="@animator/button_raise" />

    <!-- Таймер -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:30"
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/btnPause"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Кнопка Пропустить (под таймером по центру) -->
    <Button
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="Пропустить"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/btn_double_border"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:stateListAnimator="@animator/button_raise"
        app:backgroundTint="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>